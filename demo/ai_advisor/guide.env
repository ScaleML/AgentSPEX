# ========== PAPER CONFIGURATION ==========
# ArXiv ID of the target paper to advise on
# Example: 2507.08870 (GUIDE)
ARXIV_ID=2507.08870

# Number of related papers to analyze
NUM_RELATED_PAPERS=3

# ========== OUTPUT CONFIGURATION ==========
# Paths below derive from AGENTSPEX_RUN_SANDBOX_DIR_ABS, which the harness
# sets to the current run's per-task dir (e.g. /workspace/outputs/GUIDE_fast_demo_<timestamp>).
# This keeps every run's PDFs, memory, and comparison files isolated.
#
# Directory where TARGET paper files (PDFs, text, chunks) will be stored
TARGET_DIR=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/target

# Directory where RELATED papers files will be stored
RELATED_DIR=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/related

# Directory where advising outputs will be saved
# Will be created automatically if it doesn't exist
RESULTS_DIR=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/advising_results

# ========== MEMORY CONFIGURATION ==========
# Memory file for TARGET paper summaries
TARGET_MEMORY_FILE=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/target_memory.json

# Memory file for RELATED papers summaries
RELATED_MEMORY_FILE=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/related_memory.json

# JSON file for storing paper comparisons
COMPARISON_FILE=${AGENTSPEX_RUN_SANDBOX_DIR_ABS}/advising_results/comparison.json

# ========== MODEL CONFIGURATION ==========
openai_model=gpt-5-mini


# ========== SAFETY LIMITS ==========
max_tokens_per_step=100000

max_tool_calls_per_step=5

plan_revision_max_steps=0