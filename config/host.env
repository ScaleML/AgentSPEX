# Host-side configuration for the persistent sandbox VM.
# Defines local paths that are mounted into the Docker container.

# local workspace shared with docker's VM_WORKSPACE
HOST_WORKSPACE=$(pwd)/workspace

# Global persistent backup location for workspace files
# If set, all workflows share one backup (more storage efficient)
# If not set, each workflow has its own backup in outputs/<task>/workspace_snapshot
WORKSPACE_PERSISTENT=$(pwd)/workspace_persistent