# VM configuration passed into the Docker sandbox container.
# Controls display, ports, MCP server, and browser settings.

## set user password to access VNC and user account
USER_PASSWORD=agent2k

VM_HOSTNAME=sandbox

## x11
DISPLAY=:100
SCREEN_SIZE=1680x1050x24

# the following x11 port is for vm internal use, and will not be exposed
RDP_PORT=5900

## VNC / noVNC  remote desktop port which will be exposed
VNC_PORT=6080


## playwright browser control

# this port is for vm internal use, and will not be exposed
CDP_PORT=9222

# whether to let browser to visually navigate to a url when feteching content from internet
BROWSER_NAV_ON_FETCH=True

# wehtehr to let broswer to open a new tab during navigation
BROWSER_NAV_OPEN_TAB=False

# local url download directory relative to VM_WORKSPACE and HOST_WORKSPACE
URL_DOWNLOAD_DIR=browser/url_downloads

# controllable TMUX session
TMUX_SESSION=vs-control

## MCP server
MCP_TRANSPORT=streamable-http
MCP_PORT=7002
MCP_BASEPATH=/mcp

# MCP_HOST controls whether to expose the MCP server: 0.0.0.0 means expose, and 127.0.0.1 means to be accessible only from the vm
MCP_HOST=0.0.0.0

# VM_WORKSPACE mapped to HOST_WORKSPACE
VM_WORKSPACE=/workspace


#### Tool specific env variables
OPENAI_API_KEY=
# See https://support.google.com/programmable-search/answer/12499034?hl=en&sjid=5129220032404156369-NC
GOOGLE_CSE_ID=
# See https://console.cloud.google.com/apis
GOOGLE_CSE_API_KEY=
FIRECRAWL_API_KEY=
# Anthropic Claude API key (used by the refiner's Model A — claude-sonnet-4-6)
ANTHROPIC_API_KEY=
# Google Gemini API key (used for figure generation via Nano Banana)
GOOGLE_API_KEY=
